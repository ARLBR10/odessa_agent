  <!-- Fork of the QTI boot control HAL. Upstream assumes that on UFS the
       xbl, xbl_config, multiimgoem and multiimgqti partitions are selected
       by the boot LUN rather than by their GPT slot attributes, and excludes
       them from every slot-attribute update. That is false on odessa: all 24
       A/B partitions must follow the target by GPT attribute, and bBootLunEn
       must select the same side. Excluding four partitions created a split boot
       chain and the bootloader refused to enumerate the partition table. See
       docs/handoff-20260725-bootloop.md; the earlier
       docs/xbl-unbootable-root-cause-20260724.md conclusion was wrong.
       Boot attributes use Motorola's hardware-verified hybrid encoding and
       preserve a successful inactive fallback. Forked from LineageOS 846dfb0
       so the hardware-verified fix survives repo sync. -->
  <remove-project name="LineageOS/android_hardware_qcom_bootctrl" />
  <project path="hardware/qcom-caf/bootctrl"
           name="ARLBR10/android_hardware_qcom_bootctrl"
           remote="github"
           revision="9ccc4a788eede6830cbe0de57df3ccf373d4a002" />
</manifest>
