  <!-- Fork of the QTI boot control HAL. Upstream assumes that on UFS the
       xbl, xbl_config, multiimgoem and multiimgqti partitions are selected
       by the boot LUN rather than by their GPT slot attributes, and excludes
       them from every slot-attribute update. That is false on odessa: MBM
       switches all 24 A/B partitions by GPT attribute and never touches
       bBootLunEn, so excluding four of them left a split boot chain and the
       bootloader refused to enumerate the partition table at all. See
       docs/handoff-20260725-bootloop.md; the earlier
       docs/xbl-unbootable-root-cause-20260724.md conclusion was wrong.
       Forked from LineageOS 846dfb0 so the fix survives repo sync and the
       build stays reproducible. -->
  <remove-project name="LineageOS/android_hardware_qcom_bootctrl" />
  <project path="hardware/qcom-caf/bootctrl"
           name="ARLBR10/android_hardware_qcom_bootctrl"
           remote="github"
           revision="6024c108fc43286e09b4d63b7c620ed8ef0a5903" />
</manifest>
